# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# 타이밍 판단(비전) 모델. 빠르게: gemini-3.5-flash-lite / 정확하게: gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.8-flash
# minimal | low | medium | high  (낮을수록 빠름. 빈 값이면 모델 기본값)
GEMINI_THINKING_LEVEL=low

# 몇 초마다 판단할지, 한 번에 몇 장(몇 초 간격)을 보낼지
ANALYZE_INTERVAL=2.0
FRAMES_PER_CALL=3
FRAME_GAP=0.5
FRAME_WIDTH=512

# 정답 허용 오차(초)
TOLERANCE_S=10
# Gemini에 보낸 프레임을 data/sessions/<id>/frames 에 저장 (나중에 온디바이스 모델 학습용)
SAVE_FRAMES=1
